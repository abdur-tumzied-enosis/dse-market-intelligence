# =============================================================================
# DSE Stock Intelligence Platform — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dse_intelligence
POSTGRES_USER=dse
POSTGRES_PASSWORD=changeme_strong_password

# Async URL for application code
DATABASE_URL=postgresql+asyncpg://dse:changeme_strong_password@localhost:5432/dse_intelligence
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://dse:changeme_strong_password@localhost:5432/dse_intelligence

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Anthropic (AI Ops Agent + LLM layer)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (ops agent uses Sonnet, sentiment uses Haiku)
AGENT_MODEL=claude-sonnet-4-6
AGENT_PROVIDER=openrouter
SENTIMENT_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# bdshare configuration
# -----------------------------------------------------------------------------
BDSHARE_CACHE_TTL=60          # seconds; 0 = disable cache
BDSHARE_RATE_LIMIT=5          # max calls/second (library default)
BDSHARE_TIMEOUT=15            # seconds per request

# -----------------------------------------------------------------------------
# AmarStock
# -----------------------------------------------------------------------------
AMARSTOCK_BASE_URL=https://api.amarstock.com
AMARSTOCK_SCRAPE_BASE_URL=https://amarstock.com
AMARSTOCK_REQUEST_DELAY=2.0   # seconds between scrape requests
AMARSTOCK_TIMEOUT=20

# -----------------------------------------------------------------------------
# DSE Direct (dsebd.org)
# -----------------------------------------------------------------------------
DSE_BASE_URL=https://www.dsebd.org
DSE_TIMEOUT=20
DSE_PLAYWRIGHT_HEADLESS=true

# -----------------------------------------------------------------------------
# World Bank API (macro fallback)
# -----------------------------------------------------------------------------
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_COUNTRY=BD

# Bangladesh Bank scrape
BB_BASE_URL=https://www.bb.org.bd

# -----------------------------------------------------------------------------
# News sources
# -----------------------------------------------------------------------------
TBS_RSS_URL=https://www.tbsnews.net/rss.xml
FINANCIAL_EXPRESS_RSS_URL=https://thefinancialexpress.com.bd/feed
DAILY_STAR_RSS_URL=https://www.thedailystar.net/frontpage/rss.xml
DHAKA_TRIBUNE_RSS_URL=https://www.dhakatribune.com/feed
PROTHOMALO_BASE_URL=https://www.prothomalo.com
NEWS_REQUEST_DELAY=1.5

# -----------------------------------------------------------------------------
# Pipeline scheduling
# -----------------------------------------------------------------------------
# APScheduler timezone
SCHEDULER_TIMEZONE=Asia/Dhaka

# Job intervals (cron expressions)
LIVE_PRICES_INTERVAL_MINUTES=5
MARKET_INDICES_INTERVAL_MINUTES=5
FUNDAMENTALS_INTERVAL_HOURS=6
ANNOUNCEMENTS_INTERVAL_HOURS=1
NEWS_INTERVAL_MINUTES=30
MACRO_INTERVAL_HOURS=24
HEALTH_CHECK_INTERVAL_HOURS=6

# Pipeline test mode — compress all intervals to minutes for ~1h verification run.
# Set true, run `make verify-pipeline`, wait 1h, run `make pipeline-report`.
# NEVER set true in production.
PIPELINE_TEST_MODE=false

# -----------------------------------------------------------------------------
# Data quality
# -----------------------------------------------------------------------------
PRICE_CHANGE_THRESHOLD_PCT=25.0   # flag if single-day change > this
MIN_TRADES_THRESHOLD=10           # flag if trades < this (possible stale)
QUALITY_ALERT_FAILURE_RATE=0.05   # alert if >5% of tickers fail quality checks

# -----------------------------------------------------------------------------
# Observability — Grafana + Prometheus
# -----------------------------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin@123
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# Alerts
# -----------------------------------------------------------------------------
# Email (WARNING + CRITICAL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=abdur.tumzied@greenlyne.ai

# WhatsApp (CRITICAL only — via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+880XXXXXXXXXX

# Telegram (CRITICAL only — via Telegram Bot API)
TELEGRAM_BOT_TOKEN="x"
TELEGRAM_CHAT_ID="y"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=changeme_32_char_secret_key_here

# Management API
MGMT_API_HOST=0.0.0.0
MGMT_API_PORT=8001
MGMT_API_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Storage (future — MinIO for PDFs)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ANNUAL_REPORTS=annual-reports
MINIO_SECURE=false
